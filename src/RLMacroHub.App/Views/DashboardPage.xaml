<Page
    x:Class="RLMacroHub.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="36,28,36,48" Spacing="22">
            <StackPanel Spacing="5">
                <TextBlock Text="RL Macro Hub" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Your Roblox macros, profiles, and overlays in one place." Style="{StaticResource MutedTextStyle}" />
            </StackPanel>

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="ROBLOX" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.RobloxIndicator, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.RobloxStatus, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.RobloxDetail, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="MACRO RUNTIME" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind ViewModel.RuntimeIndicator, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.RuntimeStatus, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.RuntimeDetail, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0">
                            <Button Content="Start runtime" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.StartRuntimeCommand}" IsEnabled="{x:Bind ViewModel.CanStartRuntime, Mode=OneWay}" />
                            <Button Content="Stop" Command="{x:Bind ViewModel.StopRuntimeCommand}" IsEnabled="{x:Bind ViewModel.CanStopRuntime, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.RuntimeActionMessage, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="Macros" Style="{StaticResource SectionTitleTextStyle}" Margin="0,6,0,0" />
            <Grid ColumnSpacing="14" RowSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <FontIcon Glyph="&#xE768;" FontSize="22" HorizontalAlignment="Left" />
                        <TextBlock Text="Autoclicker" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.AutoclickerState, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.AutoclickerSummary, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                        <Button Content="Configure" HorizontalAlignment="Left" Command="{x:Bind ViewModel.ConfigureCommand}" CommandParameter="autoclicker" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <FontIcon Glyph="&#xE765;" FontSize="22" HorizontalAlignment="Left" />
                        <TextBlock Text="Keybinds" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.KeybindState, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.KeybindSummary, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                        <Button Content="Configure" HorizontalAlignment="Left" Command="{x:Bind ViewModel.ConfigureCommand}" CommandParameter="keybinds" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <TextBlock Text="Mana Overlay" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.ManaOverlayState, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Focused-Roblox PNG guide." Style="{StaticResource MutedTextStyle}" />
                        <Button Content="Configure" HorizontalAlignment="Left" Command="{x:Bind ViewModel.ConfigureCommand}" CommandParameter="mana" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <TextBlock Text="Gate Macro" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.GateMacroState, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.GateMacroSummary, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" />
                        <Button Content="Configure" HorizontalAlignment="Left" Command="{x:Bind ViewModel.ConfigureCommand}" CommandParameter="gate" />
                    </StackPanel>
                </Border>
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="9">
                        <TextBlock Text="Backwards Run" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind ViewModel.BackwardsRunState, Mode=OneWay}" Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Text="Legacy W + S or double-tap A/S/D movement sequence." Style="{StaticResource MutedTextStyle}" />
                        <Button Content="Configure" HorizontalAlignment="Left" Command="{x:Bind ViewModel.ConfigureCommand}" CommandParameter="backwards-run" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
