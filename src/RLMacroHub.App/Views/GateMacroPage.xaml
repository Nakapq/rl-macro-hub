<Page
    x:Class="RLMacroHub.App.Views.GateMacroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RLMacroHub.App.ViewModels">
    <ScrollViewer>
        <StackPanel Padding="36,28,36,48" Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
            <StackPanel Spacing="5">
                <TextBlock Text="Gate Macro" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Expand short gate notations into full locations while using Roblox chat." Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="Roblox chat workflow" Message="Type or edit an exact notation in any Roblox chat or destination prompt. The mapping is expanded only when you press Enter, then submitted. Gate-slot detection is not required." />
            <ToggleSwitch Header="Gate notation expansion enabled" IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" />
            <Border Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel Spacing="10">
                    <Grid Padding="4,0,40,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="NOTATION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="FULL LOCATION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Mappings}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:GateMappingItemViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{x:Bind Notation, Mode=TwoWay}" PlaceholderText="e.g. d5" MaxLength="20" />
                                        <TextBox Grid.Column="1" Text="{x:Bind Location, Mode=TwoWay}" PlaceholderText="e.g. desert 5" MaxLength="120" />
                                        <Button Grid.Column="2" Width="36" Height="32" Padding="0" Command="{x:Bind RemoveCommand}" ToolTipService.ToolTip="Remove mapping">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Error, Mode=OneWay}" FontSize="12" Foreground="{StaticResource DangerBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="＋ Add mapping" Command="{x:Bind ViewModel.AddMappingCommand}" />
                        <Button Content="Restore defaults" Command="{x:Bind ViewModel.RestoreDefaultsCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <InfoBar IsOpen="{x:Bind ViewModel.HasValidationError, Mode=OneWay}" Severity="Warning" IsClosable="False" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Save mappings" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
