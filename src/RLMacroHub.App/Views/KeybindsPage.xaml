<Page
    x:Class="RLMacroHub.App.Views.KeybindsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RLMacroHub.App.ViewModels">
    <ScrollViewer>
        <StackPanel Padding="36,28,36,48" Spacing="16" MaxWidth="860" HorizontalAlignment="Left">
            <StackPanel Spacing="5">
                <TextBlock Text="Keybinds" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Mappings are dynamic, saved with the active profile, and shared with the modular AHK v2 runtime." Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <ToggleSwitch Header="Key remapping enabled" IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" />
            <Border Style="{StaticResource CardStyle}" Padding="18">
                <StackPanel Spacing="10">
                    <Grid Padding="4,0,40,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="SOURCE KEY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Grid.Column="1" Text="TARGET KEY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}" />
                    </Grid>
                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.Bindings}">
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:KeyBindingItemViewModel">
                                <StackPanel Spacing="4" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{x:Bind Source, Mode=TwoWay}" PlaceholderText="e.g. x" />
                                        <TextBox Grid.Column="1" Text="{x:Bind Target, Mode=TwoWay}" PlaceholderText="e.g. 0" />
                                        <Button Grid.Column="2" Width="36" Height="32" Padding="0" Command="{x:Bind RemoveCommand}" ToolTipService.ToolTip="Remove binding">
                                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="{x:Bind Error, Mode=OneWay}" FontSize="12" Foreground="{StaticResource DangerBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                    <Button Content="＋ Add binding" HorizontalAlignment="Left" Command="{x:Bind ViewModel.AddBindingCommand}" />
                </StackPanel>
            </Border>
            <InfoBar IsOpen="{x:Bind ViewModel.HasValidationError, Mode=OneWay}" Severity="Warning" IsClosable="False" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Save bindings" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
