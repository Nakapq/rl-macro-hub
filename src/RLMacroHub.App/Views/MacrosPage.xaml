<Page
    x:Class="RLMacroHub.App.Views.MacrosPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:RLMacroHub.App.ViewModels">
    <ScrollViewer>
        <StackPanel Padding="36,28,36,48" Spacing="18">
            <TextBlock Text="Macro library" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Implemented modules share one modular AHK v2 runtime. Planned modules stay explicit until they exist." Style="{StaticResource MutedTextStyle}" />
            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Items}">
                <ItemsRepeater.Layout>
                    <UniformGridLayout MaximumRowsOrColumns="2" MinItemWidth="320" MinRowSpacing="14" MinColumnSpacing="14" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="vm:MacroListItem">
                        <Border Style="{StaticResource CardStyle}" MinHeight="150" Margin="0,0,0,14">
                            <StackPanel Spacing="9">
                                <TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="SemiBold" />
                                <Grid>
                                    <TextBlock Text="{x:Bind Status}" Foreground="{StaticResource SuccessBrush}" Opacity="{x:Bind AvailableStatusOpacity}" />
                                    <TextBlock Text="{x:Bind Status}" Foreground="{StaticResource WarningBrush}" Opacity="{x:Bind PlannedStatusOpacity}" />
                                </Grid>
                                <TextBlock Text="{x:Bind Description}" Style="{StaticResource MutedTextStyle}" />
                                <TextBlock Text="Open from the sidebar" FontSize="12" Foreground="{ThemeResource SystemAccentColor}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </StackPanel>
    </ScrollViewer>
</Page>
