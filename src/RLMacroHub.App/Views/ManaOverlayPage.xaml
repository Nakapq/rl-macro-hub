<Page
    x:Class="RLMacroHub.App.Views.ManaOverlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="36,28,36,48" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Spacing="5">
                <TextBlock Text="Mana Overlay" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="A transparent, click-through mana guide aligned to the Roblox client." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
            </StackPanel>

            <Border Style="{StaticResource SettingCardStyle}">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="14">
                        <TextBlock Text="Runtime behavior" Style="{StaticResource SectionTitleTextStyle}" />
                        <ToggleSwitch Header="Show mana overlay" IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}" />
                        <TextBlock Text="The overlay appears only while Roblox is focused, hides when Roblox is minimized or loses focus, and never intercepts mouse input." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#16000000" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24,10">
                        <Grid Width="46" Height="360">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,46,360" />
                            </Grid.Clip>
                            <Image Source="ms-appx:///Assets/ManaOverlay.png" Width="1920" Height="1080" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Image.RenderTransform>
                                    <TranslateTransform X="-13" Y="-549" />
                                </Image.RenderTransform>
                            </Image>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Placement" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="The complete 1920 × 1080 transparent reference is stretched over the Roblox client so its original alignment is preserved. Position and scale are optional whole-canvas adjustments." Style="{StaticResource MutedTextStyle}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="14" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <NumberBox Header="Horizontal position (%)" Value="{x:Bind ViewModel.HorizontalPositionPercent, Mode=TwoWay}" Minimum="-100" Maximum="200" SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Column="1" Header="Vertical position (%)" Value="{x:Bind ViewModel.VerticalPositionPercent, Mode=TwoWay}" Minimum="-100" Maximum="200" SmallChange="0.1" SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Row="1" Header="Scale (%)" Value="{x:Bind ViewModel.ScalePercent, Mode=TwoWay}" Minimum="25" Maximum="300" SmallChange="5" SpinButtonPlacementMode="Compact" />
                        <NumberBox Grid.Row="1" Grid.Column="1" Header="Opacity (%)" Value="{x:Bind ViewModel.OpacityPercent, Mode=TwoWay}" Minimum="10" Maximum="100" SmallChange="5" SpinButtonPlacementMode="Compact" />
                    </Grid>
                    <Button Content="Restore exact client alignment" Command="{x:Bind ViewModel.RestoreReferencePositionCommand}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Save mana overlay" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.SaveCommand}" />
                <TextBlock Text="{x:Bind ViewModel.SaveStatus, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
