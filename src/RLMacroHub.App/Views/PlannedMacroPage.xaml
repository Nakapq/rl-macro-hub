<Page
    x:Class="RLMacroHub.App.Views.PlannedMacroPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="36,28,36,48">
        <Border Style="{StaticResource CardStyle}" MaxWidth="650" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel Spacing="14">
                <Border Background="#40392316" CornerRadius="12" Padding="10,4" HorizontalAlignment="Left">
                    <TextBlock Text="PLANNED" Foreground="{StaticResource WarningBrush}" FontSize="12" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="{x:Bind PageTitle}" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="{x:Bind Description}" Style="{StaticResource MutedTextStyle}" FontSize="15" />
                <TextBlock Text="This module is intentionally not shown as working until its runtime behavior is implemented and tested." Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
