<Page
    x:Class="RLMacroHub.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Padding="36,28,36,48" Spacing="16" MaxWidth="820" HorizontalAlignment="Left">
            <StackPanel Spacing="5">
                <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Application behavior and modular AutoHotkey v2 configuration." Style="{StaticResource MutedTextStyle}" />
            </StackPanel>
            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Application" Style="{StaticResource SectionTitleTextStyle}" />
                    <ToggleSwitch Header="Start with Windows" IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}" IsEnabled="False" OffContent="Planned" />
                    <ToggleSwitch Header="Minimize to tray" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" IsEnabled="False" OffContent="Planned" />
                    <TextBlock Text="Data directory" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.DataDirectory}" Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SettingCardStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="AutoHotkey runtime configuration" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBox Header="Explicit executable path (optional)" Text="{x:Bind ViewModel.AutoHotkeyExecutablePath, Mode=TwoWay}" PlaceholderText="C:\Program Files\AutoHotkey\v2\AutoHotkey64.exe" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Export runtime config" Command="{x:Bind ViewModel.ExportRuntimeIniCommand}" />
                    </StackPanel>
                    <TextBlock Text="Start and stop controls are available on the Dashboard." Style="{StaticResource MutedTextStyle}" />
                </StackPanel>
            </Border>
            <InfoBar IsOpen="{x:Bind ViewModel.HasActionableError, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="Action needed" Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Content="Save settings" Command="{x:Bind ViewModel.SaveCommand}" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource MutedTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
